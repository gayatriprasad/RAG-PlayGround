# The OSS default path (SQLite + ChromaDB + Ollama) needs NOTHING below.
# Set only the keys for providers/backends you actually use. Never commit .env.

# --- LLM providers (optional — default provider is ollama, no key needed) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Cloud vector DBs (optional — default backend is chroma, local) ---
PINECONE_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
MILVUS_TOKEN=

# --- Database (optional — default backend is sqlite, no DSN needed) ---
DATABASE_URL=

# --- Observability (optional) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# --- Local LLM server ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- API auth (optional — set to require Authorization: Bearer on shared instances) ---
API_KEY=
